<div class="d-flex justify-content-between align-items-center mb-4">
  <h4 class="fw-bold"><i class="bi bi-people text-primary me-2"></i>Nhân sự thuộc Phòng ban ID: <%= departmentID %></h4>
  <a href="/departments" class="btn btn-outline-secondary">
    <i class="bi bi-arrow-left me-1"></i>Quay lại
  </a>
</div>

<% if (typeof permissionError !== 'undefined' && permissionError) { %>
  <div class="alert alert-warning d-flex align-items-center justify-content-between p-3 mb-4 shadow-sm" role="alert">
    <div>
      <i class="bi bi-exclamation-triangle-fill fs-5 me-2"></i>
      <strong>Phát hiện lỗi quyền 403:</strong> <%= permissionMessage %>
    </div>
    <form method="POST" action="/departments/fix/<%= departmentID %>" class="d-inline ms-3" onsubmit="return confirm('Hệ thống sẽ xoá và tạo lại phòng ban này qua API app để cấp đúng quyền Place ID. Tiếp tục?');">
      <button type="submit" class="btn btn-warning fw-bold text-dark text-nowrap">
        <i class="bi bi-wrench-adjustable me-1"></i>Fix ngay (Tạo lại qua App)
      </button>
    </form>
  </div>
<% } %>

<div class="row g-4">
  <!-- Cột trái: Form gán nhân sự -->
  <div class="col-md-5">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-header bg-success text-white py-3">
        <h5 class="mb-0"><i class="bi bi-person-plus-fill me-2"></i>Gán Nhân sự vào Phòng ban này</h5>
      </div>
      <div class="card-body p-4">
        <form method="POST" action="/departments/<%= departmentID %>/members/add">
          <div class="mb-3">
            <label class="form-label fw-semibold">Chọn Nhân sự từ Danh sách (*)</label>
            <select name="personIDs" class="form-select" multiple size="8" required>
              <% if (allPersons.length === 0) { %>
                <option disabled>Không có dữ liệu nhân sự để gán</option>
              <% } %>
              <% allPersons.forEach(p => { %>
                <% const pID = p.id || p.personID; %>
                <option value="<%= pID %>">
                  <%= p.name %> - <%= p.aliasID || p.alias_id || 'Không mã' %> (<%= p.title || 'NV' %>)
                </option>
              <% }) %>
            </select>
            <div class="form-text text-muted my-2">
              <i class="bi bi-info-circle me-1"></i>Giữ Ctrl (Windows) hoặc Command (Mac) để chọn nhiều người.
            </div>
          </div>

          <button type="submit" class="btn btn-success w-100 fw-bold py-2">
            <i class="bi bi-plus-circle me-1"></i>Thêm vào Phòng ban
          </button>
        </form>
      </div>
    </div>
  </div>

  <!-- Cột phải: Danh sách thành viên hiện tại -->
  <div class="col-md-7">
    <div class="card shadow-sm border-0 h-100">
      <div class="card-header bg-dark text-white py-3">
        <h5 class="mb-0"><i class="bi bi-people-fill me-2"></i>Danh sách Nhân sự Hiện tại (<%= members.length %>)</h5>
      </div>
      <div class="card-body p-0">
        <div class="table-responsive">
          <table class="table table-hover align-middle mb-0">
            <thead class="table-light">
              <tr>
                <th>#</th>
                <th>Ảnh</th>
                <th>Họ tên</th>
                <th>Mã NV</th>
                <th>Chức vụ</th>
              </tr>
            </thead>
            <tbody>
              <% if (members.length === 0) { %>
                <tr>
                  <td colspan="5" class="text-center text-muted py-4">Chưa có nhân sự trong phòng ban này.</td>
                </tr>
              <% } %>
              <% members.forEach((m, index) => { %>
                <tr>
                  <td><%= index + 1 %></td>
                  <td>
                    <img src="<%= m.avatar || '/images/default-avatar.png' %>" alt="Avatar" class="rounded-circle border" style="width: 36px; height: 36px; object-fit: cover;" onerror="this.onerror=null;this.src='data:image/svg+xml;utf8,<svg xmlns=\'http://www.w3.org/2000/svg\' width=\'100\' height=\'100\' viewBox=\'0 0 24 24\' fill=\'none\' stroke=\'%23ccc\' stroke-width=\'1.5\'><circle cx=\'12\' cy=\'8\' r=\'4\'/><path d=\'M4 20c0-4 4-6 8-6s8 2 8 6\'/></svg>';">
                  </td>
                  <td class="fw-bold text-primary"><%= m.name %></td>
                  <td><span class="badge bg-secondary"><%= m.aliasID || m.alias_id || '—' %></span></td>
                  <td><%= m.title || 'Nhân viên' %></td>
                </tr>
              <% }) %>
            </tbody>
          </table>
        </div>
      </div>
    </div>
  </div>
</div>
