<!DOCTYPE html>
<html lang="vi">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=no">
  <title>Đăng Ký Nhận Diện Khuôn Mặt - <%= className %></title>
  <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/css/bootstrap.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.1/font/bootstrap-icons.css">
  <style>
    body {
      background-color: #f4f6f9;
      font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
    }
    .register-card {
      max-width: 520px;
      margin: 20px auto;
      border-radius: 16px;
      border: none;
      box-shadow: 0 8px 24px rgba(0,0,0,0.08);
      background: #ffffff;
    }
    .canvas-container {
      position: relative;
      width: 100%;
      aspect-ratio: 1280 / 738;
      background: #111;
      border-radius: 12px;
      overflow: hidden;
      touch-action: none;
      cursor: grab;
      user-select: none;
      -webkit-user-select: none;
    }
    .canvas-container:active {
      cursor: grabbing;
    }
    .focus-oval {
      position: absolute;
      top: 50%;
      left: 50%;
      transform: translate(-50%, -50%);
      width: 44%;
      height: 76%;
      border: 3px dashed #00e676;
      border-radius: 50%;
      pointer-events: none;
      box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.45);
    }
    .guide-text {
      position: absolute;
      bottom: 8px;
      width: 100%;
      text-align: center;
      color: #ffffff;
      font-size: 13px;
      font-weight: 500;
      text-shadow: 0 1px 4px rgba(0,0,0,0.9);
      pointer-events: none;
    }
  </style>
</head>
<body>

<div class="container px-3 py-2">
  <div class="card register-card p-4">
    
    <div class="text-center mb-3">
      <div class="d-inline-flex align-items-center justify-content-center bg-primary-subtle text-primary rounded-circle mb-2" style="width: 54px; height: 54px;">
        <i class="bi bi-person-bounding-box fs-3"></i>
      </div>
      <h4 class="fw-bold text-dark mb-1">Đăng Ký Khuôn Mặt Face ID</h4>
      <span class="badge bg-primary px-3 py-2 fs-6 rounded-pill"><%= className %></span>
    </div>

    <% if (typeof messages !== 'undefined' && messages.error) { %>
      <div class="alert alert-danger alert-dismissible fade show rounded-3 py-2 small" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-1"></i> <%= messages.error %>
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
      </div>
    <% } %>
    <% if (typeof messages !== 'undefined' && messages.success) { %>
      <div class="alert alert-success alert-dismissible fade show rounded-3 py-2 small" role="alert">
        <i class="bi bi-check-circle-fill me-1"></i> <%= messages.success %>
        <button type="button" class="btn-close py-2" data-bs-dismiss="alert"></button>
      </div>
    <% } %>

    <form id="registerForm" action="/register/<%= className %>" method="POST" enctype="multipart/form-data">
      
      <div class="mb-3">
        <label for="personSelect" class="form-label fw-bold text-dark">Họ và Tên Nhân Sự / Học Viên <span class="text-danger">*</span></label>
        <% if (typeof persons !== 'undefined' && persons.length > 0) { %>
          <select class="form-select form-select-lg rounded-3 mb-2" id="personSelect" name="personName">
            <option value="">-- Chọn tên trong danh sách lớp --</option>
            <% (persons || []).forEach(function(p) { %>
              <option value="<%= p.name %>" data-title="<%= p.title || '' %>">
                <%= p.name %> <%= p.hasFace ? '✔ (Đã có ảnh - Bấm để chụp lại)' : '' %>
              </option>
            <% }); %>
            <option value="__custom__">+ Nhập họ và tên mới (nếu chưa có)</option>
          </select>
          <input type="text" class="form-control form-control-lg rounded-3 d-none" id="customNameInput" placeholder="Nhập đầy đủ Tên Thánh - Họ và Tên">
        <% } else { %>
          <input type="text" class="form-control form-control-lg rounded-3" name="personName" placeholder="Ví dụ: GIUSE Nguyễn Văn A" required>
        <% } %>
      </div>

      <div class="mb-3">
        <label for="titleInput" class="form-label fw-bold text-dark">Chức Vụ / Vai Trò</label>
        <input type="text" class="form-control rounded-3" id="titleInput" name="title" value="<%= defaultTitle || '' %>" placeholder="Tự động nhận theo lớp">
      </div>

      <div class="mb-4">
        <label class="form-label fw-bold text-dark">Ảnh Khuôn Mặt <span class="text-danger">*</span></label>
        
        <div class="alert alert-info py-2 px-3 small border-0 rounded-3 mb-3">
          <i class="bi bi-info-circle-fill me-1"></i> <strong>Hướng dẫn:</strong> Chụp mới hoặc tải ảnh từ máy. Sau đó <strong>dùng ngón tay kéo khuôn mặt</strong> vào giữa vòng tròn và <strong>kéo thanh trượt</strong> để phóng to rõ mặt.
        </div>

        <input type="file" id="cameraInput" accept="image/*" capture="user" class="d-none">
        <input type="file" id="galleryInput" accept="image/*" class="d-none">

        <div class="row g-2 mb-2" id="actionBtnGroup">
          <div class="col-6">
            <button type="button" id="btnCamera" class="btn btn-outline-primary w-100 py-3 rounded-3 fw-semibold shadow-xs h-100">
              <i class="bi bi-camera display-6 d-block mb-1"></i>
              <span>Chụp Ảnh Mới</span>
            </button>
          </div>
          <div class="col-6">
            <button type="button" id="btnGallery" class="btn btn-outline-success w-100 py-3 rounded-3 fw-semibold shadow-xs h-100">
              <i class="bi bi-images display-6 d-block mb-1 text-success"></i>
              <span>Tải Ảnh Từ Máy</span>
            </button>
          </div>
        </div>

        <div id="cropWrapper" class="mt-2 d-none">
          <div class="canvas-container shadow-sm" id="canvasContainer">
            <canvas id="cropCanvas" width="1280" height="738" style="width: 100%; height: 100%; display: block;"></canvas>
            <div class="focus-oval"></div>
            <div class="guide-text">
              <i class="bi bi-arrows-move me-1"></i> Chạm vuốt kéo mặt vào giữa vòng tròn
            </div>
          </div>

          <div class="bg-light p-2 rounded-3 mt-2 border d-flex align-items-center gap-2">
            <i class="bi bi-zoom-out text-secondary fs-5 ms-1"></i>
            <input type="range" class="form-range" id="zoomRange" min="1" max="3.5" step="0.02" value="1">
            <i class="bi bi-zoom-in text-secondary fs-5 me-1"></i>
          </div>

          <div class="text-center mt-2">
            <button type="button" id="btnChangePhoto" class="btn btn-sm btn-link text-decoration-none text-muted">
              <i class="bi bi-arrow-repeat me-1"></i> Chụp hoặc chọn lại ảnh khác
            </button>
          </div>
        </div>
      </div>

      <button type="submit" id="submitBtn" class="btn btn-primary w-100 py-3 rounded-3 fw-bold fs-6 shadow-sm">
        <i class="bi bi-cloud-arrow-up-fill me-1"></i> Đăng Ký Nhận Diện
      </button>

    </form>
  </div>
</div>

<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.0/dist/js/bootstrap.bundle.min.js"></script>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const personSelect = document.getElementById('personSelect');
  const customNameInput = document.getElementById('customNameInput');
  const titleInput = document.getElementById('titleInput');
  
  const cameraInput = document.getElementById('cameraInput');
  const galleryInput = document.getElementById('galleryInput');
  const btnCamera = document.getElementById('btnCamera');
  const btnGallery = document.getElementById('btnGallery');
  const btnChangePhoto = document.getElementById('btnChangePhoto');
  const actionBtnGroup = document.getElementById('actionBtnGroup');
  
  const cropWrapper = document.getElementById('cropWrapper');
  const canvasContainer = document.getElementById('canvasContainer');
  const canvas = document.getElementById('cropCanvas');
  const ctx = canvas.getContext('2d');
  const zoomRange = document.getElementById('zoomRange');
  
  const registerForm = document.getElementById('registerForm');
  const submitBtn = document.getElementById('submitBtn');

  if (personSelect) {
    personSelect.addEventListener('change', function () {
      if (this.value === '__custom__') {
        customNameInput.classList.remove('d-none');
        customNameInput.required = true;
        customNameInput.name = 'personName';
        personSelect.name = '';
      } else {
        if (customNameInput) {
          customNameInput.classList.add('d-none');
          customNameInput.required = false;
        }
        personSelect.name = 'personName';
        const opt = personSelect.options[personSelect.selectedIndex];
        const title = opt ? opt.getAttribute('data-title') : '';
        if (title && titleInput) titleInput.value = title;
      }
    });
  }

  btnCamera.addEventListener('click', () => cameraInput.click());
  btnGallery.addEventListener('click', () => galleryInput.click());

  if (btnChangePhoto) {
    btnChangePhoto.addEventListener('click', () => {
      cropWrapper.classList.add('d-none');
      actionBtnGroup.classList.remove('d-none');
    });
  }

  let img = new Image();
  let imgLoaded = false;
  let baseScale = 1;
  let currentZoom = 1;
  let posX = 0;
  let posY = 0;
  let isDragging = false;
  let startX = 0;
  let startY = 0;

  cameraInput.addEventListener('change', handleImageSelect);
  galleryInput.addEventListener('change', handleImageSelect);

  function handleImageSelect(e) {
    const file = e.target.files && e.target.files[0];
    if (!file) return;

    const objUrl = URL.createObjectURL(file);
    img = new Image();
    img.onload = function () {
      URL.revokeObjectURL(objUrl);
      imgLoaded = true;

      const TARGET_W = 1280;
      const TARGET_H = 738;
      const targetRatio = TARGET_W / TARGET_H;
      const imgRatio = img.naturalWidth / img.naturalHeight;

      if (imgRatio > targetRatio) {
        baseScale = TARGET_H / img.naturalHeight;
      } else {
        baseScale = TARGET_W / img.naturalWidth;
      }

      currentZoom = 1;
      zoomRange.value = 1;

      posX = (TARGET_W - img.naturalWidth * baseScale) / 2;
      posY = (TARGET_H - img.naturalHeight * baseScale) / 2;

      cropWrapper.classList.remove('d-none');
      actionBtnGroup.classList.add('d-none');
      redraw();
    };
    img.src = objUrl;
  }

  function redraw() {
    if (!imgLoaded) return;
    ctx.clearRect(0, 0, 1280, 738);

    const effScale = baseScale * currentZoom;
    const w = img.naturalWidth * effScale;
    const h = img.naturalHeight * effScale;

    ctx.drawImage(img, posX, posY, w, h);
  }

  zoomRange.addEventListener('input', function () {
    const newZoom = parseFloat(this.value);
    const centerX = 1280 / 2;
    const centerY = 738 / 2;
    const zoomFactor = newZoom / currentZoom;

    posX = centerX - (centerX - posX) * zoomFactor;
    posY = centerY - (centerY - posY) * zoomFactor;

    currentZoom = newZoom;
    redraw();
  });

  function getCoords(e) {
    if (e.touches && e.touches.length > 0) {
      return { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }
    return { x: e.clientX, y: e.clientY };
  }

  function startDrag(e) {
    if (!imgLoaded) return;
    isDragging = true;
    const c = getCoords(e);
    startX = c.x;
    startY = c.y;
  }

  function doDrag(e) {
    if (!isDragging) return;
    if (e.cancelable) e.preventDefault();

    const c = getCoords(e);
    const rect = canvas.getBoundingClientRect();
    const factor = 1280 / rect.width;

    const dx = (c.x - startX) * factor;
    const dy = (c.y - startY) * factor;

    posX += dx;
    posY += dy;

    startX = c.x;
    startY = c.y;

    redraw();
  }

  function endDrag() {
    isDragging = false;
  }

  canvasContainer.addEventListener('mousedown', startDrag);
  window.addEventListener('mousemove', doDrag);
  window.addEventListener('mouseup', endDrag);

  canvasContainer.addEventListener('touchstart', startDrag, { passive: false });
  canvasContainer.addEventListener('touchmove', doDrag, { passive: false });
  canvasContainer.addEventListener('touchend', endDrag);

  registerForm.addEventListener('submit', function (e) {
    if (!imgLoaded) {
      e.preventDefault();
      alert('Vui lòng chụp ảnh hoặc chọn ảnh khuôn mặt trước khi đăng ký!');
      return;
    }

    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang tải lên và nhận diện...';

    canvas.toBlob(function (blob) {
      if (!blob) {
        alert('Lỗi xử lý ảnh, vui lòng thử lại!');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="bi bi-cloud-arrow-up-fill me-1"></i> Đăng Ký Nhận Diện';
        return;
      }

      const formData = new FormData(registerForm);
      formData.set('image', blob, 'avatar.jpg');

      fetch(registerForm.action || window.location.href, {
        method: 'POST',
        body: formData
      })
      .then(res => {
        if (res.redirected) {
          window.location.href = res.url;
        } else {
          return res.text().then(html => {
            document.open();
            document.write(html);
            document.close();
          });
        }
      })
      .catch(err => {
        console.error('Lỗi gửi form:', err);
        alert('Lỗi kết nối máy chủ, vui lòng thử lại!');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="bi bi-cloud-arrow-up-fill me-1"></i> Đăng Ký Nhận Diện';
      });
    }, 'image/jpeg', 0.90);
  });
});
</script>

</body>
</html>
