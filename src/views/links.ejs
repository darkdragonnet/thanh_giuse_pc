<div class="container py-4" style="max-width: 860px;">
  <!-- Header Tinh Gọn (Không có nút đăng ký tự do) -->
  <div class="d-flex flex-wrap justify-content-between align-items-center mb-3 gap-2">
    <div>
      <h4 class="fw-bold mb-1 text-dark d-flex align-items-center">
        <span class="p-2 bg-primary-subtle text-primary rounded-3 me-2 d-inline-flex align-items-center justify-content-center" style="width: 38px; height: 38px;">
          <i class="bi bi-link-45deg fs-4"></i>
        </span>
        Danh Sách Link Đăng Ký Theo Lớp
      </h4>
      <div class="text-muted small">
        Tổng số: <span class="badge bg-light text-dark border fw-semibold"><%= (links || []).length %></span> lớp | Chỉ đăng ký qua link chỉ định
      </div>
    </div>
    <a href="/" class="btn btn-outline-secondary btn-sm rounded-pill px-3 shadow-xs">
      <i class="bi bi-people me-1"></i> Quản Lý Nhân Sự
    </a>
  </div>

  <!-- Thanh Lọc Nhanh -->
  <div class="card border-0 shadow-sm rounded-3 mb-3">
    <div class="card-body p-2">
      <div class="input-group input-group-sm">
        <span class="input-group-text bg-white border-0 text-muted"><i class="bi bi-search"></i></span>
        <input type="text" id="searchClass" class="form-control border-0 shadow-none" placeholder="Tìm kiếm nhanh theo tên lớp (VD: BaoDong, ThemSuc, GLV, DMHCCC)...">
      </div>
    </div>
  </div>

  <!-- Bảng Danh Sách Link Gộp Cột -->
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="table-responsive">
      <table class="table table-hover align-middle mb-0" id="linkTable">
        <thead class="table-light border-bottom">
          <tr>
            <th class="text-center text-secondary small py-3" style="width: 60px;">STT</th>
            <th class="text-secondary small py-3">Thông Tin Lớp & Link Đăng Ký</th>
            <th class="text-end text-secondary small py-3 pe-4" style="width: 170px;">Thao Tác</th>
          </tr>
        </thead>
        <tbody id="linkTableBody">
          <% if (!links || links.length === 0) { %>
            <tr>
              <td colspan="3" class="text-center py-5 text-muted">
                <i class="bi bi-folder2-open display-4 opacity-25 d-block mb-2"></i>
                Chưa có danh sách lớp nào trong thư mục data.
              </td>
            </tr>
          <% } else { %>
            <% links.forEach((item, index) => { %>
              <% 
                // Làm sạch tên lớp: bỏ đuôi .csv nếu có
                const cleanClassName = item.name.replace(/\.csv$/i, '');
              %>
              <tr class="link-row border-bottom border-light-subtle" data-search="<%= cleanClassName.toLowerCase() %>">
                <!-- Cột 1: STT -->
                <td class="text-center text-muted fw-semibold py-3 font-monospace">
                  <%= index + 1 %>
                </td>

                <!-- Cột 2 & 3 GỘP THÀNH 1 CỘT: Tên Lớp & Link Thụt Lề -->
                <td class="py-3">
                  <!-- Hàng 1: Thêm chữ "Lớp" và tên nhóm -->
                  <div class="fw-bold text-dark fs-6 d-flex align-items-center mb-1">
                    <i class="bi bi-mortarboard-fill text-primary me-2"></i>
                    <span>Lớp <%= cleanClassName %></span>
                  </div>

                  <!-- Hàng 2: Link đăng ký có tab index thụt lùi đầu dòng -->
                  <div class="ps-4 ms-2">
                    <span class="text-muted small me-1">Link:</span>
                    <a href="<%= item.url %>" target="_blank" class="text-decoration-none font-monospace small text-primary text-break">
                      <%= item.url %>
                    </a>
                  </div>
                </td>

                <!-- Cột Thao Tác Bên Phải -->
                <td class="text-end py-3 pe-4">
                  <div class="d-inline-flex gap-2">
                    <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 shadow-xs btn-copy-link" data-url="<%= item.url %>" data-classname="Lớp <%= cleanClassName %>">
                      <i class="bi bi-clipboard me-1"></i> Copy
                    </button>
                    <a href="<%= item.url %>" target="_blank" class="btn btn-sm btn-light border rounded-pill px-3 shadow-xs" title="Mở trang đăng ký">
                      <i class="bi bi-box-arrow-up-right"></i> Mở
                    </a>
                  </div>
                </td>
              </tr>
            <% }) %>
          <% } %>

          <tr id="noLinkResult" style="display: none;">
            <td colspan="3" class="text-center py-4 text-muted">
              Không tìm thấy lớp nào phù hợp với từ khóa.
            </td>
          </tr>
        </tbody>
      </table>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    // 1. Tìm kiếm / lọc nhanh tên lớp
    const searchInput = document.getElementById('searchClass');
    const rows = document.querySelectorAll('.link-row');
    const noResult = document.getElementById('noLinkResult');

    if (searchInput) {
      searchInput.addEventListener('input', function() {
        const keyword = this.value.trim().toLowerCase();
        let matchCount = 0;

        rows.forEach(r => {
          const name = r.dataset.search || '';
          if (name.includes(keyword)) {
            r.style.display = '';
            matchCount++;
          } else {
            r.style.display = 'none';
          }
        });

        if (noResult) {
          noResult.style.display = (matchCount === 0 && rows.length > 0) ? '' : 'none';
        }
      });
    }

    // 2. Xử lý nút Copy Link
    document.querySelectorAll('.btn-copy-link').forEach(btn => {
      btn.addEventListener('click', function() {
        const url = this.dataset.url;
        navigator.clipboard.writeText(url).then(() => {
          const originalContent = this.innerHTML;
          this.className = 'btn btn-sm btn-success rounded-pill px-3 shadow-xs';
          this.innerHTML = '<i class="bi bi-check2 me-1"></i> Đã Chép!';
          setTimeout(() => {
            this.className = 'btn btn-sm btn-outline-primary rounded-pill px-3 shadow-xs';
            this.innerHTML = originalContent;
          }, 1500);
        }).catch(err => {
          console.error('Không thể copy:', err);
        });
      });
    });
  });
</script>

<style>
  .shadow-xs { box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
  .table > :not(caption) > * > * { padding: 0.85rem 0.75rem; }
</style>
