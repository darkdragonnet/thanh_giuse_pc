<div class="container py-4" style="max-width: 600px;">
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
      <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-person-bounding-box me-2"></i>Đăng Ký Face ID</h4>
      <a href="/links" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-link-45deg me-1"></i>Xem Theo Lớp
      </a>
    </div>
    
    <div class="card-body bg-light-subtle p-3 p-md-4">
      <form id="registerForm" action="/register" method="POST" enctype="multipart/form-data">
        
        <!-- Lưu ý chụp ảnh chuẩn HANET -->
        <div class="alert alert-info border-0 shadow-xs mb-4 p-3 rounded-3" role="alert">
          <h6 class="alert-heading fw-bold mb-2"><i class="bi bi-info-circle-fill me-1"></i>Hướng Dẫn Chụp Ảnh Chuẩn:</h6>
          <ul class="mb-0 small ps-3">
            <li>Chụp <strong>chính diện, rõ mặt</strong>, mắt nhìn thẳng camera.</li>
            <li>Đảm bảo môi trường <strong>đủ ánh sáng</strong>.</li>
            <li><strong>KHÔNG</strong> đeo khẩu trang, kính đen, đội nón, và chỉ có 1 người trong khung hình.</li>
          </ul>
        </div>

        <div class="mb-3">
          <label for="nameInput" class="form-label fw-semibold text-secondary">Họ và Tên (*)</label>
          <input type="text" class="form-control form-control-lg cacheable-input" id="nameInput" name="name" placeholder="Ví dụ: Nguyễn Văn A" required>
        </div>

        <div class="mb-3">
          <label for="aliasInput" class="form-label fw-semibold text-secondary">Mã NV / Alias ID (*)</label>
          <input type="text" class="form-control cacheable-input" id="aliasInput" name="aliasID" placeholder="Ví dụ: NV_001" required>
        </div>

        <div class="mb-3">
          <label for="titleInput" class="form-label fw-semibold text-secondary">Chức Vụ</label>
          <input type="text" class="form-control cacheable-input" id="titleInput" name="title" placeholder="Ví dụ: Giáo Lý Viên / Học Sinh">
        </div>

        <div class="mb-3">
          <label for="departmentSelect" class="form-label fw-semibold text-secondary">Phòng Ban (Tùy chọn)</label>
          <select name="departmentID" id="departmentSelect" class="form-select cacheable-input">
            <option value="">-- Chưa gán phòng ban --</option>
            <% if (typeof departments !== 'undefined' && departments.length > 0) { %>
              <% departments.forEach(dept => { %>
                <option value="<%= dept.id %>">
                  <%= dept.name %> (<%= dept.numEmployee || dept.num_employee || 0 %> thành viên)
                </option>
              <% }) %>
            <% } %>
          </select>
        </div>
        
        <div class="mb-4">
          <label class="form-label fw-semibold text-secondary">Ảnh Khuôn Mặt (*)</label>
          <!-- Nút kích hoạt Camera gốc (hỗ trợ Zalo In-App Browser) -->
          <input type="file" class="form-control form-control-lg" id="avatarInput" accept="image/jpeg, image/png, image/jpg" capture="user" required>
          <!-- Thẻ ẩn chứa file thực tế đã được resize -->
          <input type="file" id="processedAvatarInput" name="face_image" style="display: none;">
          
          <div class="mt-3 text-center d-none" id="previewContainer">
            <img id="imagePreview" src="" alt="Preview" class="img-thumbnail rounded-4 shadow-sm" style="max-height: 250px; object-fit: cover;">
          </div>
        </div>

        <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm fw-bold">
          <i class="bi bi-cloud-arrow-up-fill me-2"></i>Đăng Ký Nhận Diện
        </button>
      </form>
    </div>
  </div>
</div>

<script>
  document.addEventListener('DOMContentLoaded', () => {
    const avatarInput = document.getElementById('avatarInput');
    const processedAvatarInput = document.getElementById('processedAvatarInput');
    const previewContainer = document.getElementById('previewContainer');
    const imagePreview = document.getElementById('imagePreview');
    const registerForm = document.getElementById('registerForm');
    const submitBtn = document.getElementById('submitBtn');

    // 1. Phục hồi và Lưu Trữ Dữ Liệu (Chống mất data khi Zalo App Switch)
    const cacheableInputs = document.querySelectorAll('.cacheable-input');
    
    // Khôi phục dữ liệu
    cacheableInputs.forEach(input => {
      const cachedValue = sessionStorage.getItem(`cache_${input.id}`);
      if (cachedValue) {
        input.value = cachedValue;
      }
      
      // Lưu lại khi người dùng gõ/chọn
      input.addEventListener('input', () => {
        sessionStorage.setItem(`cache_${input.id}`, input.value);
      });
      input.addEventListener('change', () => {
        sessionStorage.setItem(`cache_${input.id}`, input.value);
      });
    });

    // Xóa session nếu trang được load với flash message "success" (Thành công)
    const successFlash = document.querySelector('.alert-success');
    if (successFlash) {
      cacheableInputs.forEach(input => sessionStorage.removeItem(`cache_${input.id}`));
    }

    // 2. Resize ảnh bằng Canvas Client-Side
    function resizeImage(file, callback) {
      const reader = new FileReader();
      reader.onload = (e) => {
        const img = new Image();
        img.onload = () => {
          const canvas = document.createElement('canvas');
          const ctx = canvas.getContext('2d');
          
          const MAX_WIDTH = 800;
          const MAX_HEIGHT = 800;
          let width = img.width;
          let height = img.height;

          if (width > height) {
            if (width > MAX_WIDTH) {
              height *= MAX_WIDTH / width;
              width = MAX_WIDTH;
            }
          } else {
            if (height > MAX_HEIGHT) {
              width *= MAX_HEIGHT / height;
              height = MAX_HEIGHT;
            }
          }

          canvas.width = width;
          canvas.height = height;
          ctx.drawImage(img, 0, 0, width, height);

          // Render preview nhanh
          imagePreview.src = canvas.toDataURL('image/jpeg', 0.8);
          previewContainer.classList.remove('d-none');

          // Chuyển canvas thành file Blob chuẩn JPEG
          canvas.toBlob((blob) => {
            const resizedFile = new File([blob], (file.name || 'avatar').replace(/\.[^/.]+$/, "") + ".jpg", {
              type: 'image/jpeg',
              lastModified: Date.now()
            });
            callback(resizedFile);
          }, 'image/jpeg', 0.8);
        };
        img.src = e.target.result;
      };
      reader.readAsDataURL(file);
    }

    // Xử lý sự kiện chọn ảnh
    avatarInput.addEventListener('change', function() {
      const file = this.files[0];
      if (file) {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang xử lý ảnh...';
        
        resizeImage(file, (resizedFile) => {
          // Gắn file đã resize vào thẻ input ẩn để gửi lên server
          const dataTransfer = new DataTransfer();
          dataTransfer.items.add(resizedFile);
          processedAvatarInput.files = dataTransfer.files;
          
          submitBtn.disabled = false;
          submitBtn.innerHTML = '<i class="bi bi-cloud-arrow-up-fill me-2"></i>Đăng Ký Nhận Diện';
        });
      }
    });

    // Đảm bảo ngăn chặn submit nếu chưa resize xong
    registerForm.addEventListener('submit', (e) => {
      if (!processedAvatarInput.files.length) {
        e.preventDefault();
        alert('Vui lòng chọn hoặc chụp ảnh khuôn mặt!');
      } else {
        submitBtn.disabled = true;
        submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>Đang tải lên HANET Cloud...';
      }
    });
  });
</script>

<style>
  .shadow-xs { box-shadow: 0 1px 2px rgba(0,0,0,0.05); }
</style>
