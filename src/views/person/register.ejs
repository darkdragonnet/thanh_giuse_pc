<div class="container py-4" style="max-width: 600px;">
  <div class="card border-0 shadow-sm rounded-4 overflow-hidden">
    <div class="card-header bg-white py-3 border-0 d-flex align-items-center justify-content-between">
      <h4 class="mb-0 fw-bold text-primary"><i class="bi bi-person-bounding-box me-2"></i>Đăng Ký Face ID</h4>
      <a href="/links" class="btn btn-sm btn-outline-secondary rounded-pill px-3">
        <i class="bi bi-link-45deg me-1"></i>Xem Theo Lớp
      </a>
    </div>
    
    <div class="card-body bg-light-subtle p-3 p-md-4">
      <form id="registerForm" action="/register" method="POST" enctype="multipart/form-data">
        
        <div class="mb-3">
          <label for="nameInput" class="form-label fw-semibold text-secondary">Họ và Tên (*)</label>
          <input type="text" class="form-control form-control-lg cacheable-input" id="nameInput" name="name" placeholder="Ví dụ: Nguyễn Văn A" required>
        </div>

        <div class="mb-3">
          <label for="aliasInput" class="form-label fw-semibold text-secondary">Mã NV / Alias ID (*)</label>
          <input type="text" class="form-control cacheable-input" id="aliasInput" name="aliasID" placeholder="Ví dụ: NV_001" required>
        </div>

        <div class="mb-3">
          <label for="titleInput" class="form-label fw-semibold text-secondary">Chức Vụ</label>
          <input type="text" class="form-control cacheable-input" id="titleInput" name="title" placeholder="Ví dụ: Giáo Lý Viên / Học Sinh">
        </div>

        <div class="mb-3">
          <label for="departmentSelect" class="form-label fw-semibold text-secondary">Phòng Ban (Tùy chọn)</label>
          <select name="departmentID" id="departmentSelect" class="form-select cacheable-input">
            <option value="">-- Chưa gán phòng ban --</option>
            <% if (typeof departments !== 'undefined' && departments.length > 0) { %>
              <% departments.forEach(dept => { %>
                <option value="<%= dept.id %>">
                  <%= dept.name %> (<%= dept.numEmployee || dept.num_employee || 0 %> thành viên)
                </option>
              <% }) %>
            <% } %>
          </select>
        </div>
        
        <!-- KHU VỰC CHỌN VÀ CĂN CHỈNH ẢNH INTERACTIVE DRAG & ZOOM -->
        <div class="mb-4">
          <label class="form-label fw-bold">Ảnh Khuôn Mặt <span class="text-danger">*</span></label>
          
          <div class="alert alert-info py-2 px-3 small border-0 rounded-3 mb-2">
            <i class="bi bi-info-circle-fill me-1"></i> <strong>Hướng dẫn:</strong> Chụp xong, bạn có thể <strong>dùng ngón tay kéo khuôn mặt</strong> vào giữa vòng tròn và <strong>chỉnh thanh trượt</strong> để phóng to rõ mặt.
          </div>

          <!-- Nút mở Camera / Chọn ảnh -->
          <input type="file" id="cameraInput" accept="image/*" capture="user" class="d-none">
          <button type="button" id="btnSelectPhoto" class="btn btn-outline-primary w-100 py-3 rounded-3 fw-semibold shadow-xs">
            <i class="bi bi-camera display-6 d-block mb-1"></i>
            <span id="btnText">Bấm Vào Đây Để Mở Camera Chụp Ảnh</span>
          </button>

          <!-- Khung Canvas tương tác Căn mặt 1280x738 -->
          <div id="cropWrapper" class="mt-3 d-none">
            <div class="position-relative rounded-4 overflow-hidden shadow-sm" style="width: 100%; aspect-ratio: 1280 / 738; background: #111; touch-action: none; cursor: grab;" id="canvasContainer">
              <!-- Canvas vẽ ảnh và xử lý Drag -->
              <canvas id="cropCanvas" width="1280" height="738" style="width: 100%; height: 100%; display: block;"></canvas>

              <!-- Khung Oval Focus tiêu điểm đè lên trên -->
              <div style="position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%); width: 44%; height: 76%; border: 3px dashed #00e676; border-radius: 50%; pointer-events: none; box-shadow: 0 0 0 9999px rgba(0, 0, 0, 0.45);">
              </div>
              
              <div style="position: absolute; bottom: 8px; width: 100%; text-align: center; color: #fff; font-size: 13px; font-weight: 500; text-shadow: 0 1px 4px rgba(0,0,0,0.9); pointer-events: none;">
                <i class="bi bi-arrows-move me-1"></i> Chạm kéo mặt vào giữa vòng tròn xanh
              </div>
            </div>

            <!-- Thanh trượt Zoom phóng to / thu nhỏ -->
            <div class="bg-light p-2 rounded-3 mt-2 border d-flex align-items-center gap-2">
              <i class="bi bi-zoom-out text-secondary fs-5 ms-1"></i>
              <input type="range" class="form-range" id="zoomRange" min="1" max="3" step="0.02" value="1">
              <i class="bi bi-zoom-in text-secondary fs-5 me-1"></i>
            </div>
          </div>
        </div>

        <button type="submit" id="submitBtn" class="btn btn-primary btn-lg w-100 rounded-pill shadow-sm fw-bold">
          <i class="bi bi-cloud-arrow-up-fill me-2"></i>Đăng Ký Nhận Diện
        </button>
      </form>
    </div>
  </div>
</div>

<script>
document.addEventListener('DOMContentLoaded', function () {
  const cameraInput = document.getElementById('cameraInput');
  const btnSelectPhoto = document.getElementById('btnSelectPhoto');
  const btnText = document.getElementById('btnText');
  const cropWrapper = document.getElementById('cropWrapper');
  const canvasContainer = document.getElementById('canvasContainer');
  const canvas = document.getElementById('cropCanvas');
  const ctx = canvas.getContext('2d');
  const zoomRange = document.getElementById('zoomRange');
  const registerForm = document.getElementById('registerForm');
  const submitBtn = document.getElementById('submitBtn');

  // 1. Phục hồi và Lưu Trữ Dữ Liệu
  const cacheableInputs = document.querySelectorAll('.cacheable-input');
  cacheableInputs.forEach(input => {
    const cachedValue = sessionStorage.getItem(`cache_${input.id}`);
    if (cachedValue) {
      input.value = cachedValue;
    }
    input.addEventListener('input', () => {
      sessionStorage.setItem(`cache_${input.id}`, input.value);
    });
    input.addEventListener('change', () => {
      sessionStorage.setItem(`cache_${input.id}`, input.value);
    });
  });

  const successFlash = document.querySelector('.alert-success');
  if (successFlash) {
    cacheableInputs.forEach(input => sessionStorage.removeItem(`cache_${input.id}`));
  }

  let img = new Image();
  let imgLoaded = false;

  // Trạng thái biến đổi ảnh
  let baseScale = 1;
  let currentZoom = 1;
  let posX = 0;
  let posY = 0;
  let isDragging = false;
  let startX = 0;
  let startY = 0;

  btnSelectPhoto.addEventListener('click', () => cameraInput.click());

  cameraInput.addEventListener('change', function (e) {
    const file = e.target.files && e.target.files[0];
    if (!file) return;

    const objUrl = URL.createObjectURL(file);
    img = new Image();
    img.onload = function () {
      URL.revokeObjectURL(objUrl);
      imgLoaded = true;

      // Khởi tạo tỷ lệ để ảnh phủ đầy khung 1280x738
      const canvasRatio = 1280 / 738;
      const imgRatio = img.naturalWidth / img.naturalHeight;

      if (imgRatio > canvasRatio) {
        baseScale = 738 / img.naturalHeight;
      } else {
        baseScale = 1280 / img.naturalWidth;
      }

      currentZoom = 1;
      zoomRange.value = 1;

      // Đặt ảnh ngay chính giữa canvas
      posX = (1280 - img.naturalWidth * baseScale) / 2;
      posY = (738 - img.naturalHeight * baseScale) / 2;

      cropWrapper.classList.remove('d-none');
      btnText.textContent = 'Chụp / Chọn Lại Ảnh Khác';
      redraw();
    };
    img.src = objUrl;
  });

  function redraw() {
    if (!imgLoaded) return;
    ctx.clearRect(0, 0, 1280, 738);

    const effectiveScale = baseScale * currentZoom;
    const w = img.naturalWidth * effectiveScale;
    const h = img.naturalHeight * effectiveScale;

    ctx.drawImage(img, posX, posY, w, h);
  }

  // Zoom slider
  zoomRange.addEventListener('input', function () {
    const newZoom = parseFloat(this.value);
    
    // Zoom xoay quanh tâm Canvas (640, 369)
    const centerX = 1280 / 2;
    const centerY = 738 / 2;
    const zoomFactor = newZoom / currentZoom;

    posX = centerX - (centerX - posX) * zoomFactor;
    posY = centerY - (centerY - posY) * zoomFactor;

    currentZoom = newZoom;
    redraw();
  });

  // Hỗ trợ Drag bằng Chuột (Desktop) & Touch (Mobile / Zalo)
  function getEventCoords(e) {
    if (e.touches && e.touches.length > 0) {
      return { x: e.touches[0].clientX, y: e.touches[0].clientY };
    }
    return { x: e.clientX, y: e.clientY };
  }

  function startDrag(e) {
    if (!imgLoaded) return;
    isDragging = true;
    canvasContainer.style.cursor = 'grabbing';
    const coords = getEventCoords(e);
    startX = coords.x;
    startY = coords.y;
  }

  function doDrag(e) {
    if (!isDragging) return;
    if (e.cancelable) e.preventDefault(); // Ngăn cuộn màn hình trên điện thoại

    const coords = getEventCoords(e);
    const rect = canvas.getBoundingClientRect();
    const factor = 1280 / rect.width; // Chuyển đổi pixel màn hình sang pixel canvas 1280

    const dx = (coords.x - startX) * factor;
    const dy = (coords.y - startY) * factor;

    posX += dx;
    posY += dy;

    startX = coords.x;
    startY = coords.y;

    redraw();
  }

  function endDrag() {
    isDragging = false;
    canvasContainer.style.cursor = 'grab';
  }

  // Gắn sự kiện chuột
  canvasContainer.addEventListener('mousedown', startDrag);
  window.addEventListener('mousemove', doDrag);
  window.addEventListener('mouseup', endDrag);

  // Gắn sự kiện chạm Touch
  canvasContainer.addEventListener('touchstart', startDrag, { passive: false });
  canvasContainer.addEventListener('touchmove', doDrag, { passive: false });
  canvasContainer.addEventListener('touchend', endDrag);

  // Submit Form: Xuất thẳng Canvas 1280x738 ra Blob JPEG
  registerForm.addEventListener('submit', function (e) {
    if (!imgLoaded) {
      e.preventDefault();
      alert('Vui lòng chụp ảnh khuôn mặt trước khi đăng ký!');
      return;
    }

    e.preventDefault();
    submitBtn.disabled = true;
    submitBtn.innerHTML = '<span class="spinner-border spinner-border-sm me-1"></span> Đang xử lý đăng ký...';

    canvas.toBlob(function (blob) {
      if (!blob) {
        alert('Lỗi xử lý ảnh, vui lòng thử lại!');
        submitBtn.disabled = false;
        return;
      }

      const formData = new FormData(registerForm);
      formData.set('face_image', blob, 'avatar.jpg');
      formData.set('image', blob, 'avatar.jpg');

      fetch(registerForm.action || window.location.href, {
        method: 'POST',
        body: formData
      })
      .then(res => {
        if (res.redirected) {
          window.location.href = res.url;
        } else {
          return res.text().then(html => {
            document.open();
            document.write(html);
            document.close();
          });
        }
      })
      .catch(err => {
        console.error('Lỗi nộp form:', err);
        alert('Lỗi kết nối máy chủ, vui lòng thử lại!');
        submitBtn.disabled = false;
        submitBtn.innerHTML = '<i class="bi bi-cloud-arrow-up-fill me-2"></i>Đăng Ký Nhận Diện';
      });
    }, 'image/jpeg', 0.90);
  });
});
</script>
